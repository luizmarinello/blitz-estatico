# Copie as linhas abaixo para o .env.local e preencha com os dados do painel do Supabase.
# URL: Project Settings > Data API (Project URL). Chave: Project Settings > API Keys > Publishable key.
# Nunca use a Secret key (sb_secret_...) no front: ela ignora a RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_
